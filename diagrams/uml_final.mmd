classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name, status, category) list~Task~
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +str special_needs
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +complete_task(task) Task
        +get_tasks(status, category) list~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +int priority
        +str preferred_time
        +str frequency
        +bool completed
        +str pet_name
        +date due_date
        +Pet pet
        +mark_complete() Task
        +next_occurrence(today) Task
        +edit(**changes) void
    }

    class ScheduledItem {
        +Task task
        +str start_time
        +str reason
    }

    class Scheduler {
        +Owner owner
        +date date
        +list~ScheduledItem~ scheduled_items
        +list~ScheduledItem~ skipped_tasks
        +generate_plan() void
        +sort_by_time(tasks)$ list~Task~
        +detect_conflicts() list~str~
        +explain_plan() list~str~
        +get_summary() dict
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Task "0..*" --> "0..1" Pet : belongs to
    Scheduler --> Owner : uses
    Scheduler "1" *-- "0..*" ScheduledItem : produces
    ScheduledItem --> Task : wraps

    note for Task "One Task object per pet.<br/>Pet.add_task raises ValueError if the task<br/>already belongs to another pet."
